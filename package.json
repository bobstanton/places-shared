{
  "name": "places-shared",
  "version": "0.0.2",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles/*.css",
    "src/obsidian/maplibre/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./place": {
      "types": "./dist/place/index.d.ts",
      "import": "./dist/place/index.js",
      "require": "./dist/place/index.cjs",
      "default": "./dist/place/index.js"
    },
    "./units": {
      "types": "./dist/units/index.d.ts",
      "import": "./dist/units/index.js",
      "require": "./dist/units/index.cjs",
      "default": "./dist/units/index.js"
    },
    "./geo": {
      "types": "./dist/geo/index.d.ts",
      "import": "./dist/geo/index.js",
      "require": "./dist/geo/index.cjs",
      "default": "./dist/geo/index.js"
    },
    "./track": {
      "types": "./dist/track/index.d.ts",
      "import": "./dist/track/index.js",
      "require": "./dist/track/index.cjs",
      "default": "./dist/track/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js",
      "require": "./dist/overlay/index.cjs",
      "default": "./dist/overlay/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "import": "./dist/map/index.js",
      "require": "./dist/map/index.cjs",
      "default": "./dist/map/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js",
      "require": "./dist/settings/index.cjs",
      "default": "./dist/settings/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./dist/services/index.cjs",
      "default": "./dist/services/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "require": "./dist/render/index.cjs",
      "default": "./dist/render/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs",
      "default": "./dist/utils/index.js"
    },
    "./worker-safe": {
      "types": "./dist/worker-safe.d.ts",
      "import": "./dist/worker-safe.js",
      "require": "./dist/worker-safe.cjs",
      "default": "./dist/worker-safe.js"
    },
    "./compression": {
      "types": "./dist/compression/index.d.ts",
      "import": "./dist/compression.js",
      "require": "./dist/compression.cjs",
      "default": "./dist/compression.js"
    },
    "./popup-styles.css": "./src/styles/popup-styles.css",
    "./obsidian/map": {
      "types": "./dist/obsidian/map/index.d.ts",
      "import": "./dist/obsidian/map/index.js",
      "require": "./dist/obsidian/map/index.cjs",
      "default": "./dist/obsidian/map/index.js"
    },
    "./obsidian/services": {
      "types": "./dist/obsidian/services/index.d.ts",
      "import": "./dist/obsidian/services/index.js",
      "require": "./dist/obsidian/services/index.cjs",
      "default": "./dist/obsidian/services/index.js"
    },
    "./obsidian/settings": {
      "types": "./dist/obsidian/settings/index.d.ts",
      "import": "./dist/obsidian/settings/index.js",
      "require": "./dist/obsidian/settings/index.cjs",
      "default": "./dist/obsidian/settings/index.js"
    },
    "./obsidian/utils": {
      "types": "./dist/obsidian/utils/index.d.ts",
      "import": "./dist/obsidian/utils/index.js",
      "require": "./dist/obsidian/utils/index.cjs",
      "default": "./dist/obsidian/utils/index.js"
    },
    "./obsidian/ui": {
      "types": "./dist/obsidian/ui/index.d.ts",
      "import": "./dist/obsidian/ui/index.js",
      "require": "./dist/obsidian/ui/index.cjs",
      "default": "./dist/obsidian/ui/index.js"
    },
    "./obsidian": {
      "types": "./dist/obsidian/index.d.ts",
      "import": "./dist/obsidian/index.js",
      "require": "./dist/obsidian/index.cjs",
      "default": "./dist/obsidian/index.js"
    },
    "./obsidian/maplibre": {
      "types": "./dist/obsidian/maplibre/index.d.ts",
      "import": "./dist/obsidian/maplibre/index.js",
      "require": "./dist/obsidian/maplibre/index.cjs",
      "default": "./dist/obsidian/maplibre/index.js"
    },
    "./maplibre-styles.css": "./src/obsidian/maplibre/styles.css",
    "./waypoint-styles.css": "./src/styles/waypoint-styles.css",
    "./loading-styles.css": "./src/styles/loading-styles.css",
    "./settings-trace-styles.css": "./src/styles/settings-trace-styles.css",
    "./error-styles.css": "./src/styles/error-styles.css",
    "./marker-styles.css": "./src/styles/marker-styles.css",
    "./search-styles.css": "./src/styles/search-styles.css",
    "./button-styles.css": "./src/styles/button-styles.css",
    "./device-position-styles.css": "./src/styles/device-position-styles.css",
    "./block-styles.css": "./src/styles/block-styles.css",
    "./maplibre": {
      "types": "./dist/maplibre/index.d.ts",
      "import": "./dist/maplibre/index.js",
      "require": "./dist/maplibre/index.cjs",
      "default": "./dist/maplibre/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs",
      "default": "./dist/ui/index.js"
    }
  },
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "description": "Shared Places models, browser components, renderer helpers, and explicit Obsidian adapters.",
  "peerDependencies": {
    "obsidian": "^1.13.1",
    "maplibre-gl": "^5.24.1 || ^6.16.0"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@googlemaps/polyline-codec": "^1.0.28",
    "knap": "0.6.0",
    "obsidian-debug-logger": "git+https://github.com/bobstanton/obsidian-debug-logger.git#e9cd205ae8da09db33b4c758488ec8200323d370",
    "placeholder-resolver": "git+https://github.com/bobstanton/placeholder-resolver.git#3ed9fc1ae04e27681788906046065f1cb7112c4f",
    "yaml": "^2.9.1",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/json": "^2.1.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "maplibre-gl": "^6.18.0",
    "maplibre-gl-v5": "npm:maplibre-gl@^5.24.1",
    "obsidian": "1.14.4",
    "tslib": "^2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "scripts": {
    "lint": "eslint src package.json",
    "dev": "node esbuild.config.mjs",
    "clean": "node -e \"const fs=require('fs'); for (const path of ['dist','types']) fs.rmSync(path,{recursive:true,force:true}); for (const file of ['main.js','main.cjs']) fs.rmSync(file,{force:true})\"",
    "build": "npm run clean && tsc --emitDeclarationOnly && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false --pretty false --skipLibCheck",
    "watch": "node esbuild.config.mjs watch",
    "prepare": "node --input-type=module -e \"import { hasBuiltExports } from './esbuild.library.mjs'; process.exit(hasBuiltExports() ? 0 : 1)\" || npm run build",
    "typecheck:v5": "tsc --noEmit --emitDeclarationOnly false --pretty false -p tsconfig.v5.json",
    "format": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo . --fix",
    "format:check": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo ."
  },
  "overrides": {
    "typescript": "6.0.3",
    "obsidian": "1.14.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  },
  "peerDependenciesMeta": {
    "obsidian": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  }
}
