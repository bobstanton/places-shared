{
  "name": "places-shared",
  "version": "0.0.1",
  "main": "main.js",
  "types": "types/main.d.ts",
  "exports": {
    ".": {
      "types": "./types/main.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./place": {
      "types": "./types/place/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./units": {
      "types": "./types/units/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./geo": {
      "types": "./types/geo/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./track": {
      "types": "./types/track/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./compression": {
      "types": "./types/compression/index.d.ts",
      "require": "./compression.js",
      "import": "./compression.js",
      "default": "./compression.js"
    },
    "./overlay": {
      "types": "./types/overlay/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./map": {
      "types": "./types/map/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./settings": {
      "types": "./types/settings/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./services": {
      "types": "./types/services/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./render": {
      "types": "./types/render/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./utils": {
      "types": "./types/utils/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./ui": {
      "types": "./types/ui/index.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./worker-safe": {
      "types": "./types/worker-safe.d.ts",
      "require": "./worker-safe.js",
      "import": "./worker-safe.js",
      "default": "./worker-safe.js"
    },
    "./popup-styles.css": "./src/styles/popup-styles.css",
    "./error-styles.css": "./src/styles/error-styles.css",
    "./loading-styles.css": "./src/styles/loading-styles.css",
    "./settings-trace-styles.css": "./src/styles/settings-trace-styles.css",
    "./waypoint-styles.css": "./src/styles/waypoint-styles.css",
    "./marker-styles.css": "./src/styles/marker-styles.css",
    "./search-styles.css": "./src/styles/search-styles.css",
    "./button-styles.css": "./src/styles/button-styles.css"
  },
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "description": "Shared library for Places providers, with common map, overlay, routing, elevation replacement, template, and utility code.",
  "peerDependencies": {
    "obsidian": "^1.13.1"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@googlemaps/polyline-codec": "^1.0.28",
    "@types/geojson": "^7946.0.16",
    "obsidian-debug-logger": "git+https://github.com/bobstanton/obsidian-debug-logger.git#e9cd205ae8da09db33b4c758488ec8200323d370",
    "placeholder-resolver": "git+https://github.com/bobstanton/placeholder-resolver.git#41493d9f47ce0c32dbb9bea540dfed02198ba671"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "obsidian": "^1.13.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "dev": "node esbuild.config.mjs",
    "clean:types": "node -e \"require('fs').rmSync('types',{recursive:true,force:true})\"",
    "build": "npm run clean:types && tsc --emitDeclarationOnly && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false --pretty false --skipLibCheck",
    "watch": "node esbuild.config.mjs watch",
    "prepare": "node -e \"process.exit(require('fs').existsSync('main.js') ? 0 : 1)\" || npm run build"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
